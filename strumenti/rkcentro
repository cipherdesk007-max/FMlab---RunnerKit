#!/usr/bin/env python3
"""RunnerKit Centro - sistema, pulizia e processi in una finestra.
   rkcentro [sistema|pulizia|processi]
Legge tutto da /proc e os.statvfs (niente programmi lanciati per misurare), aggiorna solo la
scheda visibile, e per la pulizia usa lo strumento `pulizia` (solo categorie sicure)."""
__version__ = "1.0.0"

import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time

if not os.environ.get("DISPLAY"):
    import glob
    s = sorted(glob.glob("/tmp/.X11-unix/X*"))
    os.environ["DISPLAY"] = ":" + s[0].rsplit("X", 1)[1] if s else ":0"

SOCK = f"/tmp/rkcentro-{os.getuid()}.sock"
SCHEDE = ("sistema", "pulizia", "processi")


def gia_aperto(scheda):
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(1)
        c.connect(SOCK)
        c.sendall(scheda.encode())
        c.close()
        return True
    except OSError:
        return False


if __name__ == "__main__":
    _scheda = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] in SCHEDE else "sistema"
    if gia_aperto(_scheda):
        sys.exit(0)

import tkinter as tk  # noqa: E402

THEMES = {
    "scuro": dict(bg="#1b1f27", key="#2a303c", fg="#e6e6e6", acc="#3b82f6", dim="#7c8696"),
    "blu": dict(bg="#0f1b2d", key="#1d3557", fg="#f1faee", acc="#e63946", dim="#8da9c4"),
    "chiaro": dict(bg="#e9edf2", key="#ffffff", fg="#1b1f27", acc="#2563eb", dim="#6b7280"),
    "verde": dict(bg="#0d1f17", key="#163828", fg="#d8f3dc", acc="#40c057", dim="#74a98a"),
}
VERDE, GIALLO, ROSSO, VIOLA = "#40c057", "#f59f00", "#fa5252", "#9775fa"
PROTETTI = {"Xvfb", "openbox", "pcmanfm", "pcmanfm-qt", "lxpanel", "lxqt-panel", "x11vnc", "init",
            "dbus-daemon", "xfce4-panel", "xfconfd", "tint2", "Xvnc", "sshd"}
F = "DejaVu Sans"


def umano_kb(k):
    k = float(k)
    if k >= 1048576:
        return f"{k / 1048576:.1f} GB"
    if k >= 1024:
        return f"{k / 1024:.0f} MB"
    return f"{k:.0f} KB"


def colore(p):
    return VERDE if p < 70 else GIALLO if p < 85 else ROSSO


# ------------------------------------------------------------ misure (solo /proc) ----------
def leggi_ram():
    v = {}
    try:
        with open("/proc/meminfo") as f:
            for r in f:
                k, x = r.split(":", 1)
                v[k] = int(x.split()[0])
    except OSError:
        return 0, 1, 0, 0
    tot = v.get("MemTotal", 1)
    disp = v.get("MemAvailable", v.get("MemFree", 0))
    return tot - disp, tot, v.get("SwapTotal", 0) - v.get("SwapFree", 0), v.get("SwapTotal", 0)


def leggi_disco(percorso="/"):
    try:
        s = os.statvfs(percorso)
        tot = s.f_blocks * s.f_frsize
        lib = s.f_bavail * s.f_frsize
        return tot - lib, tot, lib
    except OSError:
        return 0, 1, 0


class Cpu:
    def __init__(self):
        self.prima = None

    def percento(self):
        try:
            with open("/proc/stat") as f:
                n = [int(x) for x in f.readline().split()[1:]]
            idle, tot = n[3] + (n[4] if len(n) > 4 else 0), sum(n)
        except (OSError, ValueError, IndexError):
            return self._da_carico()
        if self.prima is None:
            self.prima = (idle, tot)
            return self._da_carico()
        di, dt = idle - self.prima[0], tot - self.prima[1]
        self.prima = (idle, tot)
        return max(0.0, min(100.0, 100.0 * (1 - di / dt))) if dt > 0 else self._da_carico()

    @staticmethod
    def _da_carico():
        try:
            return min(100.0, os.getloadavg()[0] * 100 / (os.cpu_count() or 1))
        except OSError:
            return 0.0


def processi():
    out = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/status") as f:
                st = dict(r.split(":", 1) for r in f if ":" in r)
            rss = int(st.get("VmRSS", "0 kB").split()[0])
            with open(f"/proc/{d}/stat") as f:
                parti = f.read().rsplit(")", 1)[1].split()
            cpu = int(parti[11]) + int(parti[12])
            with open(f"/proc/{d}/cmdline", "rb") as f:
                cmd = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
            out.append((int(d), st.get("Name", "?").strip(), rss, cpu, cmd))
        except (OSError, ValueError, IndexError):
            continue
    return out


def uptime():
    try:
        with open("/proc/uptime") as f:
            u = int(float(f.read().split()[0]))
        return f"{u // 3600}h {u % 3600 // 60:02d}m"
    except OSError:
        return "?"


# ------------------------------------------------------------ finestra ---------------------
class Centro:
    def __init__(self, scheda="sistema"):
        try:
            with open(os.path.expanduser("~/.config/touchpad.json")) as f:
                self.tema = THEMES.get(json.load(f).get("theme", "scuro"), THEMES["scuro"])
        except Exception:
            self.tema = THEMES["scuro"]
        r = self.root = tk.Tk()
        r.title("RunnerKit Centro")
        r.configure(bg=self.T("bg"))
        sw, sh = r.winfo_screenwidth(), r.winfo_screenheight()
        w, h = min(720, sw - 20), min(470, sh - 50)
        r.geometry(f"{w}x{h}+{max(0, (sw - w) // 2)}+{max(0, (sh - h) // 2 - 10)}")
        self.W = w
        self.cpu = Cpu()
        self.storia = []         # (ram%, cpu%) ultimi campioni
        self.cpu_proc = {}       # pid -> (tick cpu, istante)
        self.chiusi = {}         # pid -> istante della richiesta di chiusura
        self.categorie = []
        self.scelte = {}
        self._lav = None
        self.pagine = {}
        self.attiva = None
        self._testata()
        self.corpo = tk.Frame(r, bg=self.T("bg"))
        self.corpo.pack(fill="both", expand=True, padx=10, pady=(0, 6))
        self.stato = tk.Label(r, text=f"RunnerKit Centro {__version__}", bg=self.T("bg"),
                              fg=self.T("dim"), font=(F, 9), anchor="w")
        self.stato.pack(fill="x", padx=12, pady=(0, 4))
        self._server()
        self.mostra(scheda)
        self._ciclo()

    def T(self, k):
        return self.tema[k]

    # ---------- testata con schede ----------
    def _testata(self):
        t = tk.Frame(self.root, bg=self.T("bg"))
        t.pack(fill="x", padx=10, pady=8)
        tk.Label(t, text="RunnerKit", bg=self.T("bg"), fg=VIOLA, font=(F, 15, "bold")).pack(side="left")
        tk.Label(t, text=" Centro", bg=self.T("bg"), fg=self.T("fg"), font=(F, 15)).pack(side="left")
        self.bottoni = {}
        for nome, etichetta in (("processi", "Processi"), ("pulizia", "Pulizia"), ("sistema", "Sistema")):
            b = self._btn(t, etichetta, lambda n=nome: self.mostra(n), bg=self.T("bg"))
            b.pack(side="right", padx=2)
            self.bottoni[nome] = b

    def _btn(self, p, testo, cmd, bg=None, fg=None, font=None):
        return tk.Button(p, text=testo, command=cmd, bg=bg or self.T("key"), fg=fg or self.T("fg"),
                         activebackground=self.T("acc"), activeforeground="white", relief="flat",
                         bd=0, highlightthickness=0, padx=12, pady=6, takefocus=0,
                         font=font or (F, 11, "bold"))

    def mostra(self, nome):
        if self.attiva:
            self.pagine[self.attiva].pack_forget()
        if nome not in self.pagine:
            fr = tk.Frame(self.corpo, bg=self.T("bg"))
            getattr(self, "_pagina_" + nome)(fr)
            self.pagine[nome] = fr
        self.pagine[nome].pack(fill="both", expand=True)
        for n, b in self.bottoni.items():
            b.config(bg=self.T("acc") if n == nome else self.T("bg"))
        self.attiva = nome
        if nome == "pulizia" and not self.categorie and not self._lav:
            self.analizza()
        self.root.deiconify()
        self.root.lift()

    # ---------- ciclo di aggiornamento: solo la scheda visibile ----------
    def _ciclo(self):
        try:
            if self.attiva == "sistema":
                self._aggiorna_sistema()
            elif self.attiva == "processi":
                self._aggiorna_processi()
        except tk.TclError:
            return
        self.root.after(2000 if self.attiva == "sistema" else 3000, self._ciclo)

    # ================= Sistema =================
    def _pagina_sistema(self, f):
        g = self.g = tk.Canvas(f, height=170, bg=self.T("bg"), highlightthickness=0)
        g.pack(fill="x")
        self.grafico = tk.Canvas(f, height=86, bg=self.T("key"), highlightthickness=0)
        self.grafico.pack(fill="x", pady=(4, 6))
        info = tk.Frame(f, bg=self.T("bg"))
        info.pack(fill="x")
        self.info = {}
        voci = ("RAM", "Swap", "Disco libero", "Carico", "Acceso da", "Processi", "GPU", "JIT")
        for i, v in enumerate(voci):
            c, rr = (i % 4) * 2, i // 4
            tk.Label(info, text=v, bg=self.T("bg"), fg=self.T("dim"), font=(F, 9)).grid(row=rr * 2, column=c // 2, sticky="w", padx=6)
            l = tk.Label(info, text="…", bg=self.T("bg"), fg=self.T("fg"), font=(F, 11, "bold"))
            l.grid(row=rr * 2 + 1, column=c // 2, sticky="w", padx=6, pady=(0, 4))
            self.info[v] = l
        for col in range(4):
            info.grid_columnconfigure(col, weight=1)

    def _anello(self, cx, cy, r, pct, titolo, sotto):
        g = self.g
        g.create_oval(cx - r, cy - r, cx + r, cy + r, outline=self.T("key"), width=14)
        if pct > 0:
            g.create_arc(cx - r, cy - r, cx + r, cy + r, start=90, extent=-min(pct, 99.9) * 3.6,
                         style="arc", outline=colore(pct), width=14)
        g.create_text(cx, cy - 6, text=f"{pct:.0f}%", fill=self.T("fg"), font=(F, 20, "bold"))
        g.create_text(cx, cy + 18, text=sotto, fill=self.T("dim"), font=(F, 9))
        g.create_text(cx, cy + r + 20, text=titolo, fill=self.T("fg"), font=(F, 11, "bold"))

    def _aggiorna_sistema(self):
        usata, tot, swu, swt = leggi_ram()
        du, dt, dl = leggi_disco()
        ram = 100 * usata / tot
        disco = 100 * du / dt if dt else 0
        cpu = self.cpu.percento()
        self.storia = (self.storia + [(ram, cpu)])[-90:]
        g = self.g
        g.delete("all")
        w = max(g.winfo_width(), self.W - 20)
        r = 52
        for i, (pct, tit, sot) in enumerate(((ram, "RAM", f"{usata // 1024} / {tot // 1024} MB"),
                                             (cpu, "Processore", f"{os.cpu_count() or '?'} core"),
                                             (disco, "Disco", f"{dl / 2**30:.1f} GB liberi"))):
            self._anello(w * (i * 2 + 1) // 6, 70, r, pct, tit, sot)
        # grafico degli ultimi 3 minuti
        c = self.grafico
        c.delete("all")
        cw, ch = max(c.winfo_width(), self.W - 20), 86
        c.create_text(8, 8, anchor="nw", text="ultimi 3 minuti", fill=self.T("dim"), font=(F, 8))
        c.create_text(cw - 8, 8, anchor="ne", text="■ RAM   ■ CPU", fill=self.T("dim"), font=(F, 8))
        for idx, col in ((0, VIOLA), (1, VERDE)):
            if len(self.storia) > 1:
                pts = []
                for j, s in enumerate(self.storia):
                    pts += [6 + j * (cw - 12) / 89, ch - 6 - s[idx] * (ch - 22) / 100]
                c.create_line(*pts, fill=col, width=2, smooth=True)
        try:
            l1 = os.getloadavg()[0]
        except OSError:
            l1 = 0
        gpu = {"mesa-metal-resident": "Metal (telefono)"}.get(os.environ.get("LR_GUI_GPU_ACTIVE", ""),
                                                            "Metal disponibile" if os.path.exists("/dev/linuxrunner-gpu") else "software")
        jit = "?"
        try:
            with open("/proc/ish/jit") as f:
                jit = next((r.split(":", 1)[1].strip() for r in f if "mode" in r.lower()), "?")
        except OSError:
            jit = "non disponibile"
        val = {"RAM": f"{usata // 1024} / {tot // 1024} MB", "Swap": f"{swu // 1024} / {swt // 1024} MB" if swt else "nessuno",
               "Disco libero": f"{dl / 2**30:.1f} GB", "Carico": f"{l1:.2f}", "Acceso da": uptime(),
               "Processi": str(sum(1 for d in os.listdir("/proc") if d.isdigit())), "GPU": gpu, "JIT": jit}
        for k, v in val.items():
            self.info[k].config(text=v, fg=(colore(ram) if k == "RAM" else self.T("fg")))
        self.stato.config(text=f"RunnerKit Centro {__version__} · aggiornato ogni 2 s")

    # ================= Pulizia =================
    def _pagina_pulizia(self, f):
        top = tk.Frame(f, bg=self.T("bg"))
        top.pack(fill="x")
        self.p_libero = tk.Label(top, text="", bg=self.T("bg"), fg=self.T("fg"), font=(F, 13, "bold"))
        self.p_libero.pack(side="left")
        self._btn(top, "↻ Analizza", self.analizza).pack(side="right")
        self.p_lista = tk.Frame(f, bg=self.T("bg"))
        self.p_lista.pack(fill="both", expand=True, pady=6)
        bot = tk.Frame(f, bg=self.T("bg"))
        bot.pack(fill="x")
        self.p_tot = tk.Label(bot, text="", bg=self.T("bg"), fg=self.T("fg"), font=(F, 11))
        self.p_tot.pack(side="left")
        self.p_pulisci = self._btn(bot, "♻  Pulisci selezionati", self.pulisci, bg=self.T("acc"), fg="white")
        self.p_pulisci.pack(side="right", padx=2)
        self._btn(bot, "Report completo", lambda: self._terminale("pulizia")).pack(side="right", padx=2)
        self.p_auto = self._btn(bot, "", self._auto_toggle)
        self.p_auto.pack(side="right", padx=2)
        self._auto_testo()

    def _auto_testo(self):
        on = os.path.exists(os.path.expanduser("~/.config/autostart/pulizia.desktop"))
        self.p_auto.config(text=f"Settimanale: {'On' if on else 'Off'}", bg=self.T("acc") if on else self.T("key"))

    def _auto_toggle(self):
        on = os.path.exists(os.path.expanduser("~/.config/autostart/pulizia.desktop"))
        subprocess.run(["pulizia", "--auto-off" if on else "--auto-on"], capture_output=True)
        self._auto_testo()

    def _libero(self):
        _, _, dl = leggi_disco()
        self.p_libero.config(text=f"Spazio libero: {dl / 2**30:.1f} GB",
                             fg=VERDE if dl > 10 * 2**30 else GIALLO if dl > 4 * 2**30 else ROSSO)

    def analizza(self):
        if not shutil.which("pulizia"):
            self.stato.config(text="strumento 'pulizia' non trovato: aggiorna RunnerKit")
            return
        self._libero()
        for w in self.p_lista.winfo_children():
            w.destroy()
        tk.Label(self.p_lista, text="Misuro quanto occupa ogni categoria…", bg=self.T("bg"),
                 fg=self.T("dim"), font=(F, 11)).pack(pady=30)
        self._lav = subprocess.Popen(["pulizia", "--json"], stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True)
        self.root.after(500, self._analisi_attendi)

    def _analisi_attendi(self):
        if self._lav.poll() is None:
            self.root.after(500, self._analisi_attendi)
            return
        out = self._lav.stdout.read()
        self._lav = None
        self.categorie = []
        for r in out.splitlines():
            p = r.split("|")
            if len(p) == 3 and p[2].strip().isdigit():
                self.categorie.append((p[0], p[1], int(p[2])))
        self._disegna_categorie()

    def _disegna_categorie(self):
        for w in self.p_lista.winfo_children():
            w.destroy()
        massimo = max([k for *_, k in self.categorie] + [1])
        for nome, desc, kb in self.categorie:
            avanzata = nome == "autoremove"
            v = self.scelte.get(nome) or tk.BooleanVar()
            v.set(kb > 0 and not avanzata)
            self.scelte[nome] = v
            riga = tk.Frame(self.p_lista, bg=self.T("key"))
            riga.pack(fill="x", pady=2)
            tk.Checkbutton(riga, variable=v, command=self._totale, bg=self.T("key"), fg=self.T("fg"),
                           selectcolor=self.T("bg"), activebackground=self.T("key"), highlightthickness=0,
                           bd=0, state="normal" if kb > 0 else "disabled").pack(side="left", padx=6)
            tk.Label(riga, text=desc + ("  · avanzato" if avanzata else ""), bg=self.T("key"),
                     fg=self.T("fg") if kb else self.T("dim"), font=(F, 10), anchor="w").pack(side="left", fill="x", expand=True)
            tk.Label(riga, text=umano_kb(kb) if kb else "vuoto", bg=self.T("key"),
                     fg=self.T("fg") if kb else self.T("dim"), font=(F, 10, "bold"), width=9, anchor="e").pack(side="right", padx=8)
            barra = tk.Canvas(riga, width=90, height=8, bg=self.T("key"), highlightthickness=0)
            barra.pack(side="right")
            barra.create_rectangle(0, 0, 90, 8, fill=self.T("bg"), outline="")
            if kb:
                barra.create_rectangle(0, 0, max(3, 90 * kb / massimo), 8, fill=VIOLA if not avanzata else GIALLO, outline="")
        self._totale()

    def _totale(self):
        t = sum(kb for n, _, kb in self.categorie if self.scelte.get(n) and self.scelte[n].get())
        self.p_tot.config(text=f"Selezionati: {umano_kb(t)}")

    def pulisci(self):
        scelte = [n for n, _, kb in self.categorie if kb and self.scelte[n].get()]
        if not scelte:
            self.stato.config(text="niente da pulire")
            return
        sicure = [n for n in scelte if n != "autoremove"]
        cmd = ""
        if sicure:
            cmd = "pulizia --sicura --solo " + ",".join(sicure)
        if "autoremove" in scelte:
            cmd += (" && " if cmd else "") + "pulizia --autoremove"
        _, _, self._prima = leggi_disco()
        self.p_pulisci.config(text="Pulizia in corso…", state="disabled")
        self._lav = subprocess.Popen(["sh", "-c", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.root.after(700, self._pulizia_attendi)

    def _pulizia_attendi(self):
        if self._lav.poll() is None:
            self.root.after(700, self._pulizia_attendi)
            return
        self._lav = None
        _, _, dopo = leggi_disco()
        lib = max(0, dopo - self._prima) / 1024
        self.p_pulisci.config(text="♻  Pulisci selezionati", state="normal")
        self.stato.config(text=f"✔ Liberati {umano_kb(lib)}")
        self.analizza()

    # ================= Processi =================
    def _pagina_processi(self, f):
        top = tk.Frame(f, bg=self.T("bg"))
        top.pack(fill="x")
        tk.Label(top, text="I programmi che usano più memoria", bg=self.T("bg"), fg=self.T("fg"),
                 font=(F, 12, "bold")).pack(side="left")
        tk.Label(top, text="aggiornato ogni 3 s", bg=self.T("bg"), fg=self.T("dim"), font=(F, 9)).pack(side="right")
        intest = tk.Frame(f, bg=self.T("bg"))
        intest.pack(fill="x", pady=(6, 0))
        for testo, wd in (("PROGRAMMA", 22), ("RAM", 9), ("CPU", 7), ("", 10)):
            tk.Label(intest, text=testo, width=wd, anchor="w", bg=self.T("bg"), fg=self.T("dim"),
                     font=(F, 9, "bold")).pack(side="left")
        self.p_righe = tk.Frame(f, bg=self.T("bg"))
        self.p_righe.pack(fill="both", expand=True)

    def _protetto(self, pid, nome, cmd):
        return (pid <= 1 or pid == os.getpid() or nome in PROTETTI
                or "/usr/local/bin/touchpad" in cmd or "rkcentro" in cmd)

    def _aggiorna_processi(self):
        ora = time.time()
        lista = processi()
        _, tot, _, _ = leggi_ram()
        ncpu = os.cpu_count() or 1
        hz = os.sysconf("SC_CLK_TCK") if hasattr(os, "sysconf") else 100
        dati = []
        for pid, nome, rss, tick, cmd in lista:
            pr = self.cpu_proc.get(pid)
            cpu = 100 * (tick - pr[0]) / hz / max(0.1, ora - pr[1]) / ncpu if pr else 0
            self.cpu_proc[pid] = (tick, ora)
            dati.append((rss, pid, nome, cpu, cmd))
        dati.sort(reverse=True)
        for w in self.p_righe.winfo_children():
            w.destroy()
        for rss, pid, nome, cpu, cmd in dati[:11]:
            riga = tk.Frame(self.p_righe, bg=self.T("key"))
            riga.pack(fill="x", pady=1)
            pct = 100 * rss / tot if tot else 0
            tk.Label(riga, text=f"{nome[:20]}", width=22, anchor="w", bg=self.T("key"), fg=self.T("fg"),
                     font=(F, 10)).pack(side="left", padx=(6, 0))
            tk.Label(riga, text=f"{rss / 1024:.0f} MB", width=9, anchor="w", bg=self.T("key"),
                     fg=colore(pct * 4), font=(F, 10, "bold")).pack(side="left")
            tk.Label(riga, text=f"{cpu:.0f}%", width=7, anchor="w", bg=self.T("key"), fg=self.T("fg"),
                     font=(F, 10)).pack(side="left")
            if self._protetto(pid, nome, cmd):
                tk.Label(riga, text="sistema", width=10, bg=self.T("key"), fg=self.T("dim"), font=(F, 9)).pack(side="right", padx=6)
            else:
                chiesto = self.chiusi.get(pid)
                forza = chiesto and ora - chiesto > 3
                b = self._btn(riga, "Forza" if forza else "Chiudi",
                              lambda p=pid, fz=forza: self._chiudi(p, fz),
                              bg=ROSSO if forza else self.T("bg"), font=(F, 9, "bold"))
                b.config(pady=2)
                b.pack(side="right", padx=6, pady=2)
        self.chiusi = {p: t for p, t in self.chiusi.items() if os.path.exists(f"/proc/{p}")}

    def _chiudi(self, pid, forza):
        try:
            os.kill(pid, signal.SIGKILL if forza else signal.SIGTERM)
            self.chiusi[pid] = time.time()
            self.stato.config(text=f"{'chiusura forzata' if forza else 'chiusura richiesta'}: pid {pid}"
                                   + ("" if forza else " (se non si chiude, tra 3 s compare 'Forza')"))
        except OSError as e:
            self.stato.config(text=f"non riesco a chiuderlo: {e}")
        self._aggiorna_processi()

    # ---------- varie ----------
    def _terminale(self, comando):
        for t in ("x-terminal-emulator", "xterm", "lxterminal", "qterminal"):
            if shutil.which(t):
                subprocess.Popen([t, "-e", "bash", "-c", comando + "; echo; for ((i=90;i>0;i--)); do "
                                  "printf '\\r  Chiudo tra %2d s · Invio per chiudere subito ' $i; "
                                  "read -r -s -t 1 && break; done"], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return

    def _server(self):
        try:
            if os.path.exists(SOCK):
                os.unlink(SOCK)
            s = self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.bind(SOCK)
            s.listen(2)
            self.root.tk.createfilehandler(s, tk.READABLE, self._sock_msg)
            self.root.protocol("WM_DELETE_WINDOW", self.chiudi)
        except OSError:
            self.sock = None

    def _sock_msg(self, *_):
        try:
            c, _ = self.sock.accept()
            m = c.recv(32).decode(errors="ignore")
            c.close()
        except OSError:
            return
        self.mostra(m if m in SCHEDE else "sistema")

    def chiudi(self):
        try:
            if self.sock:
                self.root.tk.deletefilehandler(self.sock)
                self.sock.close()
                os.unlink(SOCK)
        except OSError:
            pass
        self.root.destroy()


if __name__ == "__main__":
    Centro(_scheda).root.mainloop()
