#!/bin/bash
# FMlab - RunnerKit Aggiorna - controlla se c'e' una versione nuova e, se c'e', la installa.
#   rkaggiorna           aggiorna solo se serve
#   rkaggiorna --forza   reinstalla comunque
# Da un'icona o da un pallino (senza terminale) apre da solo una finestra di terminale,
# che si chiude da sola alla fine (Invio per chiuderla subito).
REPO="${RK_REPO:-https://raw.githubusercontent.com/cipherdesk007-max/FMlab---RunnerKit/stabile}"
LOCALE_F=/usr/local/share/runnerkit/versione
if [ ! -t 1 ] && [ -z "$RK_DENTRO" ] && [ -n "$DISPLAY" ]; then
  for t in x-terminal-emulator xterm lxterminal qterminal xfce4-terminal; do
    command -v "$t" >/dev/null 2>&1 && exec env RK_DENTRO=1 "$t" -e "$0" "$@"
  done
fi

v() { printf '\033[%sm' "$1"; }
chiudi() {  # $1 secondi: conto alla rovescia, Invio chiude subito (solo nella finestra aperta da icona/pallino)
  [ -n "$RK_DENTRO" ] || return 0
  echo
  for ((i = $1; i > 0; i--)); do
    printf '\r  %sChiudo tra %2d s · Invio per chiudere subito%s ' "$(v 2)" "$i" "$(v 0)"
    read -r -s -t 1 && break
  done
  echo
}

printf '%s== Aggiornamento FMlab - RunnerKit ==%s\n' "$(v '1;35')" "$(v 0)"
if [ -d /tmp/runnerkit-installa.lock ] && [ -n "$(find /tmp/runnerkit-installa.lock -maxdepth 0 -mmin -15 2>/dev/null)" ]; then
  printf '  %s… Un aggiornamento e'"'"' gia'"'"' in corso: aspetta che finisca.%s\n' "$(v 33)" "$(v 0)"
  chiudi 5; exit 0
fi
locale=$(cat "$LOCALE_F" 2>/dev/null)
T=$(date +%s)   # salta la cache di GitHub (~5 minuti)
remota=$(curl -fsSL --retry 2 --max-time 15 "$REPO/VERSIONE?t=$T" 2>/dev/null | tr -d '[:space:]')
# solo una versione vera (AAAA.MM.GG-N): una rete con pagina di accesso risponde con HTML
[[ $remota =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}-[0-9]+$ ]] || remota=""
if [ -z "$remota" ]; then
  printf '  %s✘ Nessuna connessione con GitHub: riprova piu'"'"' tardi.%s\n' "$(v 31)" "$(v 0)"
  chiudi 8; exit 1
fi
if [ "$remota" = "$locale" ] && [ "$1" != --forza ]; then
  printf '  %s✔ RunnerKit e'"'"' gia'"'"' aggiornato%s (versione %s)\n' "$(v '1;32')" "$(v 0)" "$locale"
  echo "  Per reinstallare comunque: rkaggiorna --forza"
  chiudi 4; exit 0
fi

echo "  Versione installata: ${locale:-nessuna}"
echo "  Versione nuova:      $remota"
echo
# l'installatore si scarica intero in un file e solo dopo si esegue:
# con "curl | sh" una connessione che cade a meta' eseguirebbe uno script troncato
INST=$(mktemp)
trap 'rm -f "$INST"' EXIT
if curl -fsSL --retry 3 --max-time 120 "$REPO/install.sh?t=$T" -o "$INST" && sh -n "$INST" && RK_T=$T RK_REPO=$REPO sh "$INST"; then
  echo
  printf '  %s✔ Aggiornato a %s%s\n' "$(v '1;32')" "$remota" "$(v 0)"
  # le novita': prima voce del registro delle modifiche
  novita=$(curl -fsSL --max-time 15 "$REPO/CHANGELOG.md?t=$T" 2>/dev/null | awk '/^## /{n++} n==1' | head -14)
  if [ -n "$novita" ]; then echo; printf '%sNovita'"'"':%s\n' "$(v 1)" "$(v 0)"; echo "$novita" | sed 's/^/  /'; fi
  echo
  echo "  I terminali gia' aperti prendono la versione nuova con: exec bash"
  chiudi 20
else
  echo
  printf '  %s✘ Aggiornamento non riuscito: il motivo e'"'"' scritto sopra. RunnerKit e'"'"' rimasto com'"'"'era.%s\n' "$(v 31)" "$(v 0)"
  chiudi 20; exit 1
fi
